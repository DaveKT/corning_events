SUMMARY:The Windmill Farm & Craft Market\, Penn Yan
DTSTART:20260815T120000Z
DTEND:20260815T203000Z
DTSTAMP:20260814T101541Z
UID:b62a7f62fc6151169dd462dbb6124d97896bc5c8@corning-events
